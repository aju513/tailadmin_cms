{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm run build:front && npm run build:admin",
        "build:front": "vite build",
        "build:admin": "vite build --config vite.admin.config.js",
        "dev": "concurrently --kill-others --names front,admin \"npm run dev:front\" \"npm run dev:admin\"",
        "dev:front": "vite",
        "dev:admin": "vite --config vite.admin.config.js"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.1.12",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.1.12",
        "vite": "^7.0.4"
    },
    "dependencies": {
        "@floating-ui/dom": "^1.7.4",
        "@fullcalendar/core": "^6.1.19",
        "@fullcalendar/daygrid": "^6.1.19",
        "@fullcalendar/interaction": "^6.1.19",
        "@fullcalendar/list": "^6.1.19",
        "@fullcalendar/timegrid": "^6.1.19",
        "@popperjs/core": "^2.11.8",
        "alpinejs": "^3.14.9",
        "apexcharts": "^5.3.5",
        "flatpickr": "^4.6.13",
        "jsvectormap": "^1.7.0",
        "prismjs": "^1.30.0",
        "swiper": "^12.0.3"
    }
}
